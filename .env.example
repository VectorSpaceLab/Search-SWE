# Copy to .env and enter your own values. .env is ignored by Git.
# Shell environment variables take precedence over this file.
# Values are literal: do not put $(commands) or ${VARIABLE} expressions here.

# Agent: choose a model and the API service used by Codex.
# Both the base URL and API key are required; no private endpoint is built in.
AGENT_MODEL=
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_API_KEY=

# Optional. Set an effort supported by your model, such as high or xhigh.
# If empty, Harbor/Codex or the supplied config determines the effort.
AGENT_REASONING_EFFORT=

# Optional native Codex TOML, relative to the repository root or absolute.
# This can define a custom provider, context window, and other Codex settings.
AGENT_CODEX_CONFIG=

# Verifier: configure the integrity judge independently of the agent.
# Its service must support the Responses API and the task's judge model.
# Trajectory audit models are fixed in each task's tests/jailbreak_judge/codex.toml.
# If both use the same service, enter the same URL and key in both sections.
# Not required for task-2-4, whose scoring uses no model judge.
VERIFIER_OPENAI_BASE_URL=
VERIFIER_OPENAI_API_KEY=

# task-1-3 only: a separate answer-equivalence judge (Chat Completions API).
# task-1-4 scores page Recall@5 directly and does not use this group.
ANSWER_JUDGE_MODEL_NAME=
ANSWER_JUDGE_BASE_URL=
ANSWER_JUDGE_API_KEY=

# Optional proxy for BOTH agent and verifier containers. Empty means this
# launcher adds no container proxy settings. Use an address reachable from
# inside Docker, not a host-only loopback address.
CONTAINER_PROXY=
CONTAINER_NO_PROXY=127.0.0.1,localhost

# Shared permitted submission APIs, separate from agent and judge credentials.
# OpenRouter: tasks 1-3, 1-4, 2-4. Jina: tasks 1-1, 1-3, 1-4, 2-4.
OPENROUTER_API_KEY=
JINA_API_KEY=

# task-1-1 uses a separate OpenRouter key restricted to its permitted models.
# It shares JINA_API_KEY above; it does not use the shared OpenRouter key.
TASK_1_1_OPENROUTER_API_KEY=
