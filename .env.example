# Search-SWE evaluation settings. Copy this file to .env, then fill only the
# groups used by your run. Never put real credentials in this tracked template.
# Shell environment variables override values in .env.
# Values are literal; do not put shell commands or ${VARIABLE} expressions here.

# ---------------------------------------------------------------------------
# 1. Coding agent
# ---------------------------------------------------------------------------
# Set the model here or pass --model to scripts/run_task.sh.
AGENT_MODEL=

# Pi agent: fill exactly the key matching the selected model.
#   deepseek/deepseek-flash -> DEEPSEEK_API_KEY
#   zai/glm-5.3-flash       -> ZAI_API_KEY
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# Optional Pi default: off, minimal, low, medium, high, or xhigh.
PI_THINKING=

# Codex agent only: fill both endpoint fields when using --agent codex.
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_API_KEY=

# Claude Code agent only: official Anthropic API key. Custom gateways, OAuth,
# Bedrock, and Vertex are not supported by the shared launcher.
AGENT_ANTHROPIC_API_KEY=

# Optional Codex or Claude Code reasoning effort.
AGENT_REASONING_EFFORT=

# Optional Codex-only settings. This is a TOML path, relative to the repository
# root or absolute.
AGENT_CODEX_CONFIG=

# ---------------------------------------------------------------------------
# 2. RewardKit 0.2.0 trajectory judge
# ---------------------------------------------------------------------------
# Required by every current task except task-2-4, regardless of which coding
# agent is selected. The judge is fixed to deepseek-flash. A Pi DeepSeek run may
# reuse the same real key in DEEPSEEK_API_KEY and VERIFIER_OPENAI_API_KEY.
VERIFIER_OPENAI_BASE_URL=https://api.deepseek.com/
VERIFIER_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 3. Task-1-3 answer-equivalence judge
# ---------------------------------------------------------------------------
# Required only by task-1-3. Harbor restricts this judge to OpenRouter.
ANSWER_JUDGE_MODEL_NAME=
ANSWER_JUDGE_BASE_URL=https://openrouter.ai/api/v1
ANSWER_JUDGE_API_KEY=

# ---------------------------------------------------------------------------
# 4. Optional APIs available to submissions
# ---------------------------------------------------------------------------
# Fill only when the selected task and your implementation use that service.
# task-1-1 uses its own restricted OpenRouter key.
TASK_1_1_OPENROUTER_API_KEY=

# OPENROUTER_API_KEY: tasks 1-3, 1-4, and 2-4.
# JINA_API_KEY: tasks 1-1, 1-3, 1-4, and 2-4.
OPENROUTER_API_KEY=
JINA_API_KEY=

# ---------------------------------------------------------------------------
# 5. Runtime egress (see docs/network-policy.md)
# ---------------------------------------------------------------------------
# General container proxies bypass allowlists; leave empty for restricted tasks.
CONTAINER_PROXY=
CONTAINER_NO_PROXY=

# Optional direct-mode upstream IPv4 DNS servers, comma-separated.
CONTAINER_DNS=
# Optional image override; defaults to hanhainebula/search-swe-egress:1.0.0.
# Pulled automatically if missing locally.
EGRESS_IMAGE=
# Optional direct/proxy JSON path. Requires CONTAINER_DNS, CONTAINER_PROXY and
# EGRESS_IMAGE to be empty. Leave empty for default direct access.
EGRESS_CONFIG=
